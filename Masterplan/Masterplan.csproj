ot;$(TargetDir)Projects&quot;&#xD;&#xA;&#xD;&#xA;REM 10. Copy .masterplan files only if the source directory exists&#xD;&#xA;if exist &quot;$(ProjectDir)..\Projects\&quot; xcopy /y &quot;$(ProjectDir)..\Projects\*.masterplan&quot; &quot;$(TargetDir)Projects\&quot;&#xD;&#xA;&#xD;&#xA;REM 11. Create BETAInstructions folder if it does NOT exist (using &quot;if not exist&quot;) &#xD;&#xA;if not exist &quot;$(TargetDir)BETAInstructions&quot; md &quot;$(TargetDir)BETAInstructions&quot;&#xD;&#xA;&#xD;&#xA;REM 12. Copy Instructions_Masterplan13_0_2.pdf only if it exists&#xD;&#xA;if exist &quot;$(ProjectDir)..\Instructions_Masterplan13_0_2.pdf&quot; xcopy /y &quot;$(ProjectDir)..\Instructions_Masterplan13_0_2.pdf&quot; &quot;$(TargetDir)BETAInstructions\&quot;" />
